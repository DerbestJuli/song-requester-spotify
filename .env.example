# Kopieren nach ".env" und ausfüllen. Die ".env" selbst NIE committen!

# --- Flask ---
# Langer zufälliger String, z. B. mit: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Passwort für den Admin-Bereich. Leer lassen = beim Start wird eins erzeugt
# und in der Konsole angezeigt.
ADMIN_PASSWORD=

# --- Netzwerk (optional) ---
PORT=5000
# Nur setzen, wenn die automatische LAN-IP-Erkennung falsch liegt.
PUBLIC_HOST=

# --- Spotify Developer App ---
# Anlegen unter https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Muss ZEICHENGENAU als Redirect-URI im Spotify-Dashboard eingetragen sein.
# Wichtig: Spotify erlaubt kein "localhost" mehr, nur die IP 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5000/spotify/callback
